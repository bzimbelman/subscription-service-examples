# 01-hello-world environment.
#
# Copy to .env and edit. The engine's full env reference is at
# https://github.com/example-org/subscription-service/blob/v1.0.0/deploy/docker/.env.example
# — only the knobs you'd actually touch for hello-world are listed here.

# Engine version / image tags. Bump these together when upgrading.
ENGINE_VERSION=v1.0.0

# Host ports. Change if 18080 / 2575 are taken on your machine.
HAPI_HOST_PORT=18080
INTERFACE_ENGINE_MLLP_HOST_PORT=2575
INTERFACE_ENGINE_HTTP_HOST_PORT=18090
MATCHBOX_HOST_PORT=18081

# Postgres credentials — fine to leave as defaults for hello-world.
POSTGRES_USER=hapi
POSTGRES_PASSWORD=hapi
POSTGRES_DB=hapi
IPF_DB_USER=ipf
IPF_DB_PASSWORD=ipf
IPF_DB_NAME=ipf
